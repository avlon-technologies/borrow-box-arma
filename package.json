{
  "name": "borrowbox",
  "version": "1.0.0",
  "private": true,
  "description": "BorrowBox — a warm personal lending library for friends and small communities.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "setup": "npm run build && npm run seed",
    "build": "vite build",
    "seed": "node server/seed.ts --reset",
    "start": "node server/index.ts",
    "dev": "node --watch-path=server server/index.ts --dev",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "express": "^5.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
